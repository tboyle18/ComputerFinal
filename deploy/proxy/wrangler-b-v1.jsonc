// Deploys build b-v1 with the Supabase proxy. Run from this folder: npx wrangler deploy -c wrangler-b-v1.jsonc
{
  "name": "b-v1",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../builds/b-v1/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sb/*"]
  },
  "vars": {
    "SUPABASE_UPSTREAM": "https://yuysazrdltissqvdgccx.supabase.co",
    "SCHEMA": "b_v1",
    "BUCKET_PREFIX": "b-v1"
  }
}
