// Cloudflare Workers (static assets) config — deploy with `npm run deploy`.
// The app is a static single-page app: every unknown path serves index.html.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trove-marketplace",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
