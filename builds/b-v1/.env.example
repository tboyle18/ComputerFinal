# Copy to .env.local and fill in from Supabase → Project Settings → API (or "Connect").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" public key.
# Never put the secret / service_role key here — everything VITE_* ends up in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
