# -----------------------------------------------------------------------------
# Frontend environment (copy to .env.local; never commit real values)
# -----------------------------------------------------------------------------
# These end up in the PUBLIC JavaScript bundle, so they must only ever be
# public values. The build fails if a secret key is detected here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *publishable* key (sb_publishable_...) or legacy *anon* key.
# NEVER the secret / service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Cloudflare Turnstile site key (bot protection on sign-up/sign-in).
# Leave empty to disable. If set, also enable CAPTCHA in Supabase Auth settings
# and set TURNSTILE_ENABLED=true in wrangler.jsonc.
VITE_TURNSTILE_SITE_KEY=
